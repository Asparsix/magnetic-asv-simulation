<?xml version="1.0"?>
<sdf version="1.10">

  <model name="simple_boat_2">

    <static>false</static>
    <pose>0 0 -0.05 0 0 0</pose>

    <link name="hull">

      <inertial>
        <pose>0 0 -0.08 0 0 0</pose>

        <mass>80.0</mass>

        <inertia>
          <ixx>0.2</ixx>
          <iyy>0.5</iyy>
          <izz>0.5</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- IMU: relative topic → /model/<entity>/... so multi-ASV does not collide -->
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <visualize>true</visualize>
        <topic>/model/simple_boat_2/imu</topic>
      </sensor>

      <!-- Magnetometer -->
      <sensor name="mag_sensor" type="magnetometer">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <visualize>true</visualize>
        <topic>/model/simple_boat_2/magnetometer</topic>

        <magnetometer>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.1</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.1</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.1</stddev>
            </noise>
          </z>
        </magnetometer>
      </sensor>

      <!-- GPS -->
      <sensor name="gps_sensor" type="navsat">
        <always_on>1</always_on>
        <update_rate>5</update_rate>
        <topic>/model/simple_boat_2/gps</topic>
      </sensor>

      <!-- Physics collision (UNCHANGED) -->
      <collision name="collision">
        <geometry>
          <box>
            <size>1.0 0.6 0.22</size>
          </box>
        </geometry>
      </collision>

      <!-- Hull Bottom -->
    <visual name="boat_mesh">
      <pose>0 0 0.08  1.5708 0 0</pose>

      <geometry>
        <mesh>
          <uri>model://simple_boat/meshes/boat.obj</uri>
          <scale>0.003 0.003 0.003</scale>
        </mesh>
      </geometry>

      <material>

        <ambient>0.1 0.3 1 1</ambient>
        <diffuse>0.1 0.35 1 1</diffuse>
        <specular>0.5 0.5 0.5 1</specular>
      </material>
    </visual>
    </link>

    <!-- LEFT THRUSTER -->
    <link name="left_thruster">

      <pose>-0.45 0.20 0 0 0 0</pose>

      <inertial>
        <mass>0.1</mass>

        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- <visual name="left_thruster_visual">

        <pose>0 0 0 0 1.5708 0</pose>

        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.12</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0 1 0 1</ambient>
          <diffuse>0 1 0 1</diffuse>
        </material>

      </visual> -->

    </link>

    <!-- RIGHT THRUSTER -->
    <link name="right_thruster">

      <pose>-0.45 -0.20 0 0 0 0</pose>

      <inertial>
        <mass>0.1</mass>

        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- <visual name="right_thruster_visual">

        <pose>0 0 0 0 1.5708 0</pose>

        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.12</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>1 1 0 1</ambient>
          <diffuse>1 1 0 1</diffuse>
        </material>

      </visual> -->

    </link>

    <!-- JOINTS -->

    <joint name="left_propeller_joint" type="revolute">
      <parent>hull</parent>
      <child>left_thruster</child>

      <axis>
        <xyz>1 0 0</xyz>
      </axis>
    </joint>

    <joint name="right_propeller_joint" type="revolute">
      <parent>hull</parent>
      <child>right_thruster</child>

      <axis>
        <xyz>1 0 0</xyz>
      </axis>
    </joint>

    <!-- HYDRODYNAMICS -->

    <plugin
      filename="gz-sim-hydrodynamics-system"
      name="gz::sim::systems::Hydrodynamics">

      <link_name>hull</link_name>

      <xUabsU>-20</xUabsU>
      <yVabsV>-50</yVabsV>
      <zWabsW>-100</zWabsW>

      <kPabsP>-300</kPabsP>
      <mQabsQ>-300</mQabsQ>
      <nRabsR>-300</nRabsR>

    </plugin>

    <!-- LEFT THRUSTER PLUGIN -->

    <plugin
      filename="gz-sim-thruster-system"
      name="gz::sim::systems::Thruster">

      <joint_name>left_propeller_joint</joint_name>

      <thrust_coefficient>0.004422</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.2</propeller_diameter>

    </plugin>

    <!-- RIGHT THRUSTER PLUGIN -->

    <plugin
      filename="gz-sim-thruster-system"
      name="gz::sim::systems::Thruster">

      <joint_name>right_propeller_joint</joint_name>

      <thrust_coefficient>0.004422</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.2</propeller_diameter>

    </plugin>
    <plugin
      filename="gz-sim-pose-publisher-system"
      name="gz::sim::systems::PosePublisher">

      <publish_link_pose>true</publish_link_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <!-- Relative → /model/<entity>/pose after the world include renames the model -->
      <topic>/model/simple_boat_2/pose</topic>

    </plugin>

    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">

      <dimensions>3</dimensions>
      <odom_frame>simple_boat_2/odom</odom_frame>
      <robot_base_frame>simple_boat_2/base_footprint</robot_base_frame>
      <!-- Relative → /model/<entity>/odometry -->
      <odom_topic>/model/simple_boat_2/odometry</odom_topic>
      <odom_publish_frequency>50</odom_publish_frequency>

    </plugin>

  </model>

</sdf>