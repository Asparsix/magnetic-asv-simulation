<?xml version="1.0"?>
<sdf version="1.10">

  <world name="niot_world">

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>13.0827</latitude_deg>
      <longitude_deg>80.2707</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <scene>
      <ambient>0.55 0.60 0.65 1</ambient>
      <background>0.52 0.75 0.95 1</background>
      <sky>
        <clouds>
          <speed>0.4</speed>
        </clouds>
      </sky>
    </scene>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1000</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 120 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>-0.3 0.2 -1</direction>
    </light>

  <!-- 300 m x 300 m lake centered at origin -->
    <model name="water_surface">
      <static>true</static>
      <link name="link">
        <visual name="water_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>300 300</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.0 0.12 0.45 0.85</ambient>
            <diffuse>0.0 0.20 0.55 0.85</diffuse>
            <specular>0.9 0.9 0.9 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Shoreline walls (collision-backed) -->
    <model name="north_shore">
      <static>true</static>
      <pose>0 155 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>320 10 3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>320 10 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.18 0.42 0.18 1</ambient>
            <diffuse>0.18 0.42 0.18 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="south_shore">
      <static>true</static>
      <pose>0 -155 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>320 10 3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>320 10 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.18 0.42 0.18 1</ambient>
            <diffuse>0.18 0.42 0.18 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="east_shore">
      <static>true</static>
      <pose>155 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>10 320 3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>10 320 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.18 0.42 0.18 1</ambient>
            <diffuse>0.18 0.42 0.18 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="west_shore">
      <static>true</static>
      <pose>-155 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>10 320 3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>10 320 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.18 0.42 0.18 1</ambient>
            <diffuse>0.18 0.42 0.18 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Corner landscaping -->
    <model name="northwest_corner">
      <static>true</static>
      <pose>-150 150 1 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>8</radius>
              <length>2</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.20 0.48 0.20 1</ambient>
            <diffuse>0.20 0.48 0.20 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="northeast_corner">
      <static>true</static>
      <pose>150 150 1 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>8</radius>
              <length>2</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.20 0.48 0.20 1</ambient>
            <diffuse>0.20 0.48 0.20 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="southeast_corner">
      <static>true</static>
      <pose>150 -150 1 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>8</radius>
              <length>2</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.20 0.48 0.20 1</ambient>
            <diffuse>0.20 0.48 0.20 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="southwest_corner">
      <static>true</static>
      <pose>-150 -150 1 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>8</radius>
              <length>2</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.20 0.48 0.20 1</ambient>
            <diffuse>0.20 0.48 0.20 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Central island -->
    <model name="island">
      <static>true</static>
      <pose>40 30 0.8 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>12</radius>
              <length>1.6</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>12</radius>
              <length>1.6</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.22 0.52 0.22 1</ambient>
            <diffuse>0.22 0.52 0.22 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Dock on southwest shore -->
    <model name="dock">
      <static>true</static>
      <pose>-120 -120 0.3 0 0 0.785</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>20 4 0.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.45 0.30 0.15 1</ambient>
            <diffuse>0.45 0.30 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Marker buoys along patrol route -->
    <model name="buoy_1">
      <static>true</static>
      <pose>-120 -120 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.6</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1 0.8 0 1</ambient>
            <diffuse>1 0.8 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="buoy_2">
      <static>true</static>
      <pose>120 -120 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.6</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1 0.8 0 1</ambient>
            <diffuse>1 0.8 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="buoy_3">
      <static>true</static>
      <pose>120 120 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.6</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1 0.8 0 1</ambient>
            <diffuse>1 0.8 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="buoy_4">
      <static>true</static>
      <pose>-120 120 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.6</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1 0.8 0 1</ambient>
            <diffuse>1 0.8 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Visual marker only: Gazebo magnetometer cannot sense local dipoles.
         The actual field anomaly is injected in mag_driver (ROS-side). -->
    <model name="magnetic_target">
      <static>true</static>
      <pose>-35 -55 2 0 0 0</pose>
      <link name="marker">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>2.0</radius>
              <length>4.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1 0.1 0.1 1</ambient>
            <diffuse>1 0.1 0.1 1</diffuse>
            <emissive>0.4 0 0 1</emissive>
          </material>
        </visual>
        <visual name="cap">
          <pose>0 0 2.5 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>1.2</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1 0.3 0.1 1</ambient>
            <diffuse>1 0.3 0.1 1</diffuse>
            <emissive>0.5 0.1 0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://simple_boat</uri>
      <name>simple_boat</name>
      <pose>-110 -110 0 0 0 0.785</pose>
    </include>

  </world>
</sdf>
